# Amazon Creators API credentials (Login with Amazon, v3.x).
# Copy to .env (gitignored) and fill in. NEVER commit the real .env.
# Get/rotate credentials: Amazon Associates Central -> Tools -> Creators API.

# Credential ID (amzn1.application-oa2-client...)
CREATORS_CLIENT_ID=

# Credential Secret (amzn1.oa2-cs.v1...)  -- keep secret, rotate if leaked
CREATORS_CLIENT_SECRET=

# Region/version: 3.1=NA  3.2=EU (amazon.de)  3.3=FE
CREATORS_VERSION=3.2

# Marketplace + your associate/partner tag
CREATORS_MARKETPLACE=www.amazon.de
CREATORS_PARTNER_TAG=huskynarr-21
